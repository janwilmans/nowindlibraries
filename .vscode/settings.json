{
  // the emuv1 .inc files are C++ fragments included by Z80.cpp, not assembler
  "files.associations": {
    "**/emuv1/**/*.inc": "cpp"
  },
  "asm-code-lens.excludeFiles": "**/emuv1/**",

  // format with the clang-format bundled with the C/C++ extension, it is recent
  // enough for .clang-format; language-specific so it beats a user-level [cpp] setting
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "none"
}
