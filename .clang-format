# matches the prevailing style of the existing sources (tabs, allman braces,
# short single-line ifs); the code is not reformatted in bulk, use this for
# new and changed code (git clang-format)
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest

UseTab: ForIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
# keep the existing line breaks, the code has many long lines
ColumnLimit: 0

# braces on their own line for functions and control statements, attached for namespaces and classes
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Always
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortCaseLabelsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always

AccessModifierOffset: -4
IndentCaseLabels: false
NamespaceIndentation: None
FixNamespaceComments: false

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: Never

# the include order is significant (libgeneral.h first, NWHOST_API_EXPORT before NowindHost.hh)
SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: Never

SpacesBeforeTrailingComments: 1
ReflowComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
